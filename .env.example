# Servidor
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
JWT_SECRET=cambia-este-secreto

# URL pública del frontend (para volver después de Wompi y generar enlaces)
FRONTEND_URL=http://localhost:3000

# Pago contra entrega (déjalo en true mientras Wompi no esté activo)
ENABLE_COD=true

# Wompi - Dashboard de comercios > Desarrolladores > Secretos
# Para pruebas usa llaves pub_test_ / prv_test_ y WOMPI_ENV=sandbox.
# Para dinero real usa llaves pub_prod_ / prv_prod_ y WOMPI_ENV=production.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
